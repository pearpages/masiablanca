---
import Base from '../layouts/Base.astro';
import { NAV } from '../lib/site.js';
import { ALL } from '../lib/species.js';
---

<Base
  title="Pàgina no trobada"
  description="Aquesta adreça no correspon a cap pàgina del lloc sobre la reserva marina de la Masia Blanca. Aquí teniu els enllaços a la història, al grapissar i al catàleg de peixos."
  noindex
>
  <div class="page nf">
    <p class="label">Error 404</p>
    <h1>Aquí no hi ha res</h1>
    <p class="nf__lede">
      L’adreça que heu seguit no correspon a cap pàgina d’aquest lloc. Potser buscàveu una de
      les {ALL.length} fitxes del catàleg de peixos.
    </p>
    <ul class="nf__nav">
      <li><a href="/">Inici</a></li>
      {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .nf {
    padding-block: var(--sp-3xl);
    max-width: var(--measure);
  }

  .nf h1 {
    margin-block-start: var(--sp-2xs);
    font-size: var(--step-5);
    font-stretch: 86%;
  }

  .nf__lede {
    margin-block-start: var(--sp-m);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .nf__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-s);
    margin: var(--sp-l) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 550;
  }
</style>
