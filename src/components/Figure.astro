---
/**
 * A Commons photograph with its attribution attached. There is deliberately no
 * way to render one of these without the credit line: the credit is part of the
 * component, not something a page has to remember to add.
 */
import { Image } from 'astro:assets';
import Credit from './Credit.astro';

const { image, alt, sizes = '(min-width: 60rem) 44rem, 100vw', widths, loading, priority = false, caption } = Astro.props;

const defaultWidths = [420, 720, 1080, 1440];
---

<figure class="fig">
  <a href={image.commonsUrl} class="fig__link" rel="external nofollow">
    <Image
      src={image.asset}
      alt={alt}
      widths={widths ?? defaultWidths}
      sizes={sizes}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      format="webp"
      quality={78}
    />
  </a>
  <figcaption>
    {caption && <span class="fig__caption">{caption}</span>}
    <Credit image={image} />
  </figcaption>
</figure>

<style>
  .fig {
    margin: 0;
  }

  .fig__link {
    display: block;
    background-color: var(--bg-alt);
    overflow: hidden;
  }

  .fig__link :global(img) {
    width: 100%;
    height: auto;
    transition: scale 0.5s var(--ease);
  }

  .fig__link:hover :global(img) {
    scale: 1.02;
  }

  figcaption {
    margin-block-start: var(--sp-2xs);
  }

  .fig__caption {
    display: block;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
    margin-block-end: 0.2rem;
  }
</style>
