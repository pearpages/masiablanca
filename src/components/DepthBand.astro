---
/**
 * The depth ruler, inline. Shows where a species sits inside the reserve's
 * 0–25 m envelope, with the 4–11 m band of the rocky bars marked for reference.
 */
import { FACTS } from '../lib/site.js';

const { from, to, colour = 'var(--accent-graphic)', compact = false } = Astro.props;
const MAX = FACTS.fondariaMax;
const pct = (m) => Math.min(100, Math.max(0, (m / MAX) * 100));
const ticks = compact ? [0, 25] : [0, 5, 10, 15, 20, 25];
---

<div class={`band${compact ? ' band--compact' : ''}`}>
  <div class="band__track">
    <span
      class="band__reef"
      style={`--from:${pct(FACTS.barresMin)}%;--to:${pct(FACTS.barresMax)}%`}
      title="Barres rocoses, 4–11 m"></span>
    <span
      class="band__span"
      style={`--from:${pct(from)}%;--to:${pct(to)}%;--c:${colour}`}></span>
    {ticks.map((m) => <span class="band__tick" style={`--at:${pct(m)}%`}></span>)}
  </div>
  {
    !compact && (
      <div class="band__axis data">
        {ticks.map((m) => (
          <span style={`--at:${pct(m)}%`}>{m}</span>
        ))}
      </div>
    )
  }
  <p class="visually-hidden">Fondària dins la reserva: de {from} a {to} metres.</p>
</div>

<style>
  .band {
    --h: 0.75rem;
  }

  .band__track {
    position: relative;
    height: var(--h);
    background-color: color-mix(in oklab, var(--text) 8%, transparent);
    border-radius: 1px;
    overflow: hidden;
  }

  .band__reef {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--from);
    width: calc(var(--to) - var(--from));
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--text) 22%, transparent) 0 2px,
      transparent 2px 5px
    );
  }

  .band__span {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--from);
    width: max(3px, calc(var(--to) - var(--from)));
    background-color: var(--c);
  }

  .band__tick {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--at);
    width: 1px;
    background-color: var(--bg);
    opacity: 0.7;
  }

  .band__axis {
    position: relative;
    height: 1.1em;
    margin-block-start: 0.25rem;
    color: var(--text-muted);
  }

  .band__axis span {
    position: absolute;
    inset-inline-start: var(--at);
    transform: translateX(-50%);
    font-size: 0.62rem;
  }

  .band__axis span:first-child {
    transform: none;
  }

  .band__axis span:last-child {
    transform: translateX(-100%);
  }

  .band--compact {
    --h: 0.4rem;
  }
</style>
