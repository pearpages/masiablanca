---
/**
 * The signature element: a persistent bathymetric scale pinned to the left edge.
 *
 * It is not decoration. The reserve is defined by a vertical axis — surface at
 * 0 m, the biogenic bars between 4 and 11 m, sand out to the 25 m limit — and
 * the ruler maps your position in the page onto that axis. Scroll to the bottom
 * of a page and you are at 25 m.
 *
 * Progressive enhancement: without JS it renders as a static, correct scale.
 */
import { FACTS } from '../lib/site.js';
import './DepthRuler.css';

const MAX = FACTS.fondariaMax;
const ticks = [0, 5, 10, 15, 20, 25];
const pct = (m) => (m / MAX) * 100;
---

<aside class="ruler" aria-hidden="true" data-depth-ruler>
  <div class="ruler__scale">
    <span
      class="ruler__band"
      style={`--from:${pct(FACTS.barresMin)}%;--to:${pct(FACTS.barresMax)}%`}></span>

    {
      ticks.map((m) => (
        <span class="ruler__tick" style={`--at:${pct(m)}%`}>
          <span class="ruler__num">{m}</span>
        </span>
      ))
    }

    <span class="ruler__cursor" data-ruler-cursor>
      <span class="ruler__readout" data-ruler-readout>0 m</span>
    </span>
  </div>
</aside>

<script>
  const ruler = document.querySelector('[data-depth-ruler]');
  if (ruler && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cursor = ruler.querySelector('[data-ruler-cursor]') as HTMLElement | null;
    const readout = ruler.querySelector('[data-ruler-readout]') as HTMLElement | null;
    const MAX_DEPTH = 25;
    let queued = false;

    const paint = () => {
      queued = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      const depth = progress * MAX_DEPTH;
      if (cursor) cursor.style.setProperty('--at', `${progress * 100}%`);
      if (readout) readout.textContent = `${depth.toFixed(depth < 10 ? 1 : 0)} m`;
      ruler.classList.toggle('is-active', progress > 0.005);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    ruler.classList.add('is-ready');
    paint();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  }
</script>
